# ==============================================================================
# TiluchiRecords - Environment Configuration Template
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=3000
FRONTEND_PORT=5173

# PostgreSQL Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password
POSTGRES_DB=tiluchirecords_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres_secure_password@localhost:5432/tiluchirecords_db?schema=public

# Redis (Queues & Caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# MinIO / S3 Object Storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=tiluchi-media
S3_FORCE_PATH_STYLE=true

# Security & JWT
JWT_SECRET=super_secret_jwt_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=7d

# External AI Providers (Spike D-08 budgets)
GEMINI_API_KEY=
OPENAI_API_KEY=
EXTERNAL_VIDEO_API_KEY=
