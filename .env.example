POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password
POSTGRES_DB=tiluchirecords_db
POSTGRES_PORT=5432

REDIS_PORT=6379

S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=tiluchi-media

JWT_SECRET=change_this_secret_for_demo_or_production_min_32_chars
CORS_ORIGIN=http://localhost:5173
JOB_STALE_TIMEOUT_MS=600000
JOB_WATCHDOG_INTERVAL_MS=30000

# Token opcional para modelos de Hugging Face que requieran aceptacion de licencia.
HF_TOKEN=

# Motores IA locales (sin APIs pagadas)
DEMUCS_MODEL=htdemucs
DEMUCS_DEVICE=auto
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
FACEFUSION_EXECUTION_PROVIDER=auto
FACEFUSION_MODEL=inswapper_128_fp16
DIFFUSION_MODEL=stable-diffusion-v1-5/stable-diffusion-v1-5
DIFFUSION_DEVICE=auto
DIFFUSION_STEPS=25
DIFFUSION_WIDTH=768
DIFFUSION_HEIGHT=432
VIDEO_DIFFUSION_MODEL=stabilityai/stable-video-diffusion-img2vid-xt
VIDEO_DIFFUSION_FRAMES=14
VIDEO_DIFFUSION_STEPS=12
VIDEO_DIFFUSION_DECODE_CHUNK=2
VIDEO_SEGMENT_SECONDS=10
VIDEO_MAX_SEGMENTS=1
